# =============================================================================
# EMPLOYEEAPP - DEDICATED STAGING & TEST ENVIRONMENT CONFIGURATION
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `server/.env.test`
# 2. Fill in the credentials for your separate STAGING Supabase project.
#
# IMPORTANT SAFETY WARNING:
# NEVER USE YOUR PRODUCTION SUPABASE CREDENTIALS IN THIS FILE.
# The integration test suite has an automated safety guard that will immediately
# abort and reject execution if the Supabase URL points to production.
# =============================================================================

# Server Port & Mode for Test Execution
PORT=5000
NODE_ENV=test
HOST=0.0.0.0

# Staging Supabase Database Credentials (REQUIRED for integration tests)
# Create a free staging project at https://supabase.com
# Obtain these from: Supabase Project Settings -> API
SUPABASE_URL=https://your-staging-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key-here

# Staging JWT Authentication Secret
JWT_SECRET=ems_staging_test_jwt_secret_key_change_if_desired_32_chars

# Staging Organization Setup Key
ORG_SETUP_KEY=staging_test_org_setup_key_2026
