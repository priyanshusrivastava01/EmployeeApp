# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL & Storage Configuration (Backend Service Role)
# Replace with your actual project credentials from https://app.supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# JWT Secret for Authentication (to be configured in Stage 2)
# JWT_SECRET=your-256-bit-secret-key
