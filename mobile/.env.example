# Expo Mobile Public Environment Configuration Template
# Copy this file to .env and configure for your target testing environment:

# 1. Physical Android Phone on Wi-Fi (Run 'ipconfig' on Windows to find your IPv4 Address):
EXPO_PUBLIC_API_URL=http://192.168.31.114:5000
EXPO_PUBLIC_DEV_LAN_IP=192.168.31.114

# 2. Android Studio Emulator:
# EXPO_PUBLIC_DEV_TARGET=emulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# 3. Web Browser:
# EXPO_PUBLIC_API_URL=http://localhost:5000

# 4. Deployed Production Backend:
# EXPO_PUBLIC_API_URL=https://employeeapp-5u4l.onrender.com
