# =============================================================================
# EXPO MOBILE ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and configure for your target testing environment:

# OPTION 1: Physical Android Phone on Local Wi-Fi (Connecting to Staging Node Server)
# (Run 'ipconfig' on Windows to find your laptop's current Wi-Fi IPv4 Address):
EXPO_PUBLIC_API_URL=http://192.168.31.113:5000
EXPO_PUBLIC_DEV_LAN_IP=192.168.31.113

# OPTION 2: Android Studio Emulator (Connecting to Staging Node Server on host)
# EXPO_PUBLIC_DEV_TARGET=emulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# OPTION 3: Web Browser Preview
# EXPO_PUBLIC_API_URL=http://localhost:5000

# OPTION 4: Deployed Production Backend (Render)
# EXPO_PUBLIC_API_URL=https://employeeapp-5u4l.onrender.com
